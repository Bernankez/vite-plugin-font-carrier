{
  "name": "vite-plugin-font-carrier",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "pnpm@9.7.0",
  "description": "Compress font on demand.",
  "author": {
    "name": "Cole",
    "email": "bernankeic@gmail.com",
    "url": "https://github.com/Bernankez"
  },
  "license": "MIT",
  "homepage": "https://github.com/Bernankez/vite-plugin-font-carrier#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bernankez/vite-plugin-font-carrier.git"
  },
  "bugs": "https://github.com/Bernankez/vite-plugin-font-carrier/issues",
  "keywords": [
    "vite",
    "font",
    "optimization",
    "compress",
    "extractor",
    "vite-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build",
    "dev": "unbuild --stub && pnpm -F \"playground\" dev",
    "build": "unbuild && pnpm -F \"playground\" build",
    "preview": "pnpm -F \"playground\" preview",
    "start": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "release": "bumpp && pnpm publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/font-carrier": "^0.3.3",
    "font-carrier": "^0.3.1",
    "fs-extra": "^11.2.0",
    "kolorist": "^1.8.0",
    "magic-string": "^0.30.11"
  },
  "devDependencies": {
    "@bernankez/eslint-config": "^1.7.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.2.0",
    "bumpp": "^9.5.1",
    "eslint": "^9.9.0",
    "lint-staged": "^15.2.9",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "unbuild": "^2.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,json,md,html,css}": "eslint --fix"
  },
  "publishConfig": {
    "access": "public"
  }
}
